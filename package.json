{
  "name": "my-backend-nest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json || tsc -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix || exit 0",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "ts-jest": "^29.1.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.3",
    "ts-node": "^10.9.1"
  }
}
